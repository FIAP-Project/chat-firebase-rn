rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function validPolicy(p) {
      return p in ['all_group_messages', 'mentioned_members', 'direct_messages_only', 'disabled'];
    }
    function validGroup(g) {
      return g.name is string && g.name.size() >= 1 && g.name.size() <= 60
        && g.photoUrl is string
        && g.memberLimit is int && g.memberLimit >= 2 && g.memberLimit <= 256
        && g.memberIds is list && g.memberIds.size() >= 2
        && g.memberIds.size() <= g.memberLimit            // limite do grupo
        && validPolicy(g.notificationPolicy);
    }

    // Perfil PÚBLICO (nome e foto). Dados cadastrais ficam em /private.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['name', 'photoUrl', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.photoUrl is string;
      allow delete: if false;

      // E-mail, celular e data de nascimento: somente o próprio dono lê pelo cliente.
      // Outros usuários consultam via API (GET /users/:uid/profile), que valida o vínculo.
      match /private/{doc} {
        allow read, write: if isSelf(uid);
      }

      // Tokens de push: nunca públicos.
      match /devices/{deviceId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ID = uidA_uidB (ordenados). Somente os dois participantes.
    match /directConversations/{cid} {
      allow read: if signedIn() && request.auth.uid in cid.split('_');
      allow create: if signedIn()
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0] < request.resource.data.participantIds[1]
        && cid == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1];
      allow update, delete: if false;
    }

    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds
        && validGroup(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Log de idempotência do push: somente a API (Admin SDK) acessa.
    match /notificationLog/{id} {
      allow read, write: if false;
    }
  }
}
